<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_atlas_stok_kapanis_wizard_form" model="ir.ui.view">
        <field name="name">atlas.stok.kapanis.wizard.form</field>
        <field name="model">atlas.stok.kapanis.wizard</field>
        <field name="arch" type="xml">
            <form string="Dönem Sonu Stok Kapanışı">
                <group>
                    <field name="date"/>
                    <field name="uretim_yansitma"/>
                    <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                </group>
                <p class="text-muted">
                    Stok değeri (seçili maliyet yöntemiyle) stok hesaplarının bakiyesiyle karşılaştırılır; fark maliyet hesaplarına
                    yazılır: 150 → 710, 151/152 → 620, 153 → 621. Kapanıştan önce o döneme ait tüm alış faturaları ve stok hareketleri girilmiş olmalıdır.
                </p>
                <footer>
                    <button name="action_kapat" type="object" string="Kapanışı Yap" class="btn-primary"/>
                    <button string="Kapat" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_atlas_stok_kapanis" model="ir.actions.act_window">
        <field name="name">Stok Kapanışı</field>
        <field name="res_model">atlas.stok.kapanis.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
