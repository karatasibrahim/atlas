<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_calendar_event_form_randevu" model="ir.ui.view">
        <field name="name">calendar.event.form.randevu</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="randevu_tur_id" invisible="1"/>
                <button name="action_randevu_onayla" type="object" string="Randevuyu Onayla" class="btn-primary"
                        invisible="randevu_durum != 'talep'"/>
                <button name="action_randevu_geldi" type="object" string="Geldi" invisible="randevu_durum not in ('onayli', 'gelmedi')"/>
                <button name="action_randevu_gelmedi" type="object" string="Gelmedi" invisible="randevu_durum not in ('onayli', 'geldi')"/>
                <button name="action_randevu_iptal" type="object" string="İptal Et" invisible="not randevu_tur_id or randevu_durum == 'iptal'"
                        confirm="Randevu iptal edilecek ve müşteriye bildirim gönderilecek."/>
                <field name="randevu_durum" widget="statusbar" statusbar_visible="talep,onayli,geldi" invisible="not randevu_tur_id"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="randevu" string="Randevu" invisible="not randevu_tur_id">
                    <group>
                        <group>
                            <field name="randevu_tur_id" readonly="1"/>
                            <field name="randevu_musteri_id"/>
                            <field name="randevu_kisi"/>
                        </group>
                        <group>
                            <field name="randevu_kaynak_ids" widget="many2many_tags"/>
                            <field name="randevu_davet_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="randevu_yanit_ids" readonly="1">
                        <list>
                            <field name="soru_id"/>
                            <field name="secenek_id"/>
                            <field name="metin"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_calendar_event_randevu_calendar" model="ir.ui.view">
        <field name="name">calendar.event.randevu.calendar</field>
        <field name="model">calendar.event</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <calendar string="Randevular" date_start="start" date_stop="stop" all_day="allday" color="randevu_tur_id" mode="week"
                      event_open_popup="true" quick_create="false">
                <field name="user_id" filters="1" avatar_field="avatar_128"/>
                <field name="randevu_tur_id" filters="1"/>
                <field name="randevu_durum"/>
                <field name="randevu_musteri_id"/>
                <field name="randevu_kaynak_ids" widget="many2many_tags"/>
                <field name="location"/>
            </calendar>
        </field>
    </record>

    <record id="view_calendar_event_randevu_list" model="ir.ui.view">
        <field name="name">calendar.event.randevu.list</field>
        <field name="model">calendar.event</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list decoration-warning="randevu_durum == 'talep'" decoration-muted="randevu_durum == 'iptal'" decoration-danger="randevu_durum == 'gelmedi'">
                <field name="start"/>
                <field name="randevu_tur_id"/>
                <field name="randevu_musteri_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="randevu_kaynak_ids" widget="many2many_tags" optional="show"/>
                <field name="randevu_kisi" optional="hide"/>
                <field name="randevu_durum" widget="badge" decoration-success="randevu_durum in ('onayli', 'geldi')"
                       decoration-warning="randevu_durum == 'talep'" decoration-danger="randevu_durum == 'gelmedi'"/>
                <button name="action_randevu_onayla" type="object" string="Onayla" icon="check" invisible="randevu_durum != 'talep'"/>
            </list>
        </field>
    </record>

    <record id="view_calendar_event_randevu_kanban" model="ir.ui.view">
        <field name="name">calendar.event.randevu.kanban</field>
        <field name="model">calendar.event</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <kanban default_group_by="randevu_durum" create="0" group_create="0" quick_create="0">
                <templates>
                    <t t-name="card">
                        <field name="randevu_musteri_id" class="fw-bold"/>
                        <field name="randevu_tur_id" class="text-muted"/>
                        <field name="start"/>
                        <footer>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_calendar_event_randevu_pivot" model="ir.ui.view">
        <field name="name">calendar.event.randevu.pivot</field>
        <field name="model">calendar.event</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <pivot string="Randevu Analizi">
                <field name="randevu_tur_id" type="row"/>
                <field name="randevu_durum" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_calendar_event_randevu_graph" model="ir.ui.view">
        <field name="name">calendar.event.randevu.graph</field>
        <field name="model">calendar.event</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <graph string="Randevu Analizi" type="bar">
                <field name="start" interval="week"/>
                <field name="randevu_tur_id"/>
            </graph>
        </field>
    </record>

    <record id="view_calendar_event_randevu_search" model="ir.ui.view">
        <field name="name">calendar.event.randevu.search</field>
        <field name="model">calendar.event</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <search>
                <field name="randevu_musteri_id"/>
                <field name="randevu_tur_id"/>
                <field name="user_id"/>
                <filter name="benim" string="Randevularım" domain="[('user_id', '=', uid)]"/>
                <filter name="talep" string="Bekleyen talepler" domain="[('randevu_durum', '=', 'talep')]"/>
                <filter name="yaklasan" string="Yaklaşan" domain="[('start', '>=', context_today().strftime('%Y-%m-%d')), ('randevu_durum', 'in', ('talep', 'onayli'))]"/>
                <filter name="iptal_degil" string="İptal edilmemiş" domain="[('randevu_durum', '!=', 'iptal')]"/>
                <separator/>
                <filter name="tarih" string="Tarih" date="start"/>
                <group>
                    <filter name="g_tur" string="Randevu Türü" context="{'group_by': 'randevu_tur_id'}"/>
                    <filter name="g_personel" string="Personel" context="{'group_by': 'user_id'}"/>
                    <filter name="g_durum" string="Durum" context="{'group_by': 'randevu_durum'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_atlas_randevu_etkinlik" model="ir.actions.act_window">
        <field name="name">Randevular</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">calendar,list,kanban,form,pivot,graph</field>
        <field name="domain">[('randevu_tur_id', '!=', False)]</field>
        <field name="context">{'search_default_iptal_degil': 1}</field>
        <field name="search_view_id" ref="view_calendar_event_randevu_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'calendar', 'view_id': ref('view_calendar_event_randevu_calendar')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_calendar_event_randevu_list')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_calendar_event_randevu_kanban')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('calendar.view_calendar_event_form')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_calendar_event_randevu_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_calendar_event_randevu_graph')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Henüz randevu yok</p>
            <p>Randevu türlerinizin bağlantısını paylaşın; alınan randevular burada görünür.</p>
        </field>
    </record>

    <record id="action_atlas_randevu_analiz" model="ir.actions.act_window">
        <field name="name">Randevu Analizi</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('randevu_tur_id', '!=', False)]</field>
        <field name="search_view_id" ref="view_calendar_event_randevu_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_calendar_event_randevu_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_calendar_event_randevu_graph')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_calendar_event_randevu_list')})]"/>
    </record>
</odoo>
