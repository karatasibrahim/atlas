<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_expense_view_form_atlas_ai" model="ir.ui.view">
        <field name="name">hr.expense.form.atlas.ai</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_atlas_ai_oku" type="object" string="AI ile Oku" invisible="state != 'draft' or atlas_ai_durum == 'kuyrukta'"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <field name="atlas_ai_durum" invisible="1"/>
                <div class="alert alert-info mb-0" role="status" invisible="atlas_ai_durum != 'okundu'">Bu masraf fişi yapay zekâyla okundu; tutarı ve kategoriyi kontrol edin.</div>
                <div class="alert alert-warning mb-0" role="alert" invisible="atlas_ai_durum != 'hata'">Okunamadı: <field name="atlas_ai_hata_mesaji" class="d-inline" readonly="1"/></div>
            </xpath>
        </field>
    </record>
</odoo>
