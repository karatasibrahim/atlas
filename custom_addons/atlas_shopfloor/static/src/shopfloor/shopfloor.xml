<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="atlas_shopfloor.App">
        <div class="o_action o_atlas_sf d-flex flex-column h-100">
            <!-- Üst bar -->
            <header class="o_atlas_sf_bar d-flex align-items-center gap-3 px-3">
                <button t-if="this.state.ekran !== 'merkez'" class="btn btn-link text-white p-0 fs-3" t-on-click="() => this.geri()" title="Geri">
                    <i class="oi" data-icon="arrow_back"/>
                </button>
                <div class="fw-bold fs-5">Üretim Alanı</div>
                <div t-if="this.state.merkez and this.state.ekran !== 'merkez'" class="o_atlas_sf_chip" t-on-click="() => this.merkezEkrani()">
                    <i class="oi" data-icon="factory"/> <t t-out="this.state.merkez.ad"/>
                </div>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <span t-if="this.state.yukleniyor" class="spinner-border spinner-border-sm"/>
                    <div t-if="this.state.operator" class="o_atlas_sf_chip" t-on-click="() => this.cikisYap()" title="Operatör değiştir">
                        <i class="oi" data-icon="person"/> <t t-out="this.state.operator.ad"/>
                    </div>
                    <button class="btn btn-link text-white p-0 fs-4" t-on-click="() => this.cikis()" title="Çıkış"><i class="oi" data-icon="logout"/></button>
                </div>
            </header>

            <main class="flex-grow-1 overflow-auto p-3">
                <!-- İş merkezi seçimi -->
                <t t-if="this.state.ekran === 'merkez'">
                    <h4 class="mb-3">İş merkezi seçin</h4>
                    <div t-if="!this.state.merkezler.length" class="text-muted">Tanımlı iş merkezi yok.</div>
                    <div class="o_atlas_sf_grid">
                        <button t-foreach="this.state.merkezler" t-as="m" t-key="m.id" class="o_atlas_sf_tile" t-att-class="'o_atlas_sf_' + m.durum"
                                t-on-click="() => this.merkezSec(m)">
                            <div class="fs-4 fw-bold" t-out="m.ad"/>
                            <div class="small opacity-75" t-out="m.kod"/>
                            <div class="mt-3 d-flex gap-2 flex-wrap">
                                <span class="badge text-bg-success" t-if="m.calisan"><t t-out="m.calisan"/> çalışıyor</span>
                                <span class="badge text-bg-primary"><t t-out="m.hazir"/> hazır</span>
                                <span class="badge text-bg-secondary" t-if="m.bekleyen"><t t-out="m.bekleyen"/> bekliyor</span>
                                <span class="badge text-bg-danger" t-if="m.durum === 'blocked'">Duruşta</span>
                            </div>
                        </button>
                    </div>
                </t>

                <!-- Operatör seçimi -->
                <t t-elif="this.state.ekran === 'operator'">
                    <t t-if="this.state.pinIcin">
                        <div class="o_atlas_sf_pin mx-auto text-center">
                            <h4 t-out="this.state.pinIcin.ad"/>
                            <div class="o_atlas_sf_pin_dots mb-3"><t t-foreach="this.state.pin.split('')" t-as="c" t-key="c_index">●</t>&#160;</div>
                            <div class="o_atlas_sf_keypad">
                                <t t-foreach="['1','2','3','4','5','6','7','8','9','sil','0','ok']" t-as="t" t-key="t">
                                    <button class="btn btn-lg" t-att-class="t === 'ok' ? 'btn-success' : 'btn-light'" t-on-click="() => this.pinTus(t)">
                                        <t t-if="t === 'sil'">⌫</t><t t-elif="t === 'ok'">Giriş</t><t t-else="" t-out="t"/>
                                    </button>
                                </t>
                            </div>
                            <button class="btn btn-link mt-2" t-on-click="() => this.pinVazgec()">Vazgeç</button>
                        </div>
                    </t>
                    <t t-else="">
                        <h4 class="mb-3">Operatör seçin</h4>
                        <div t-if="!this.state.operatorler.length" class="text-muted">Çalışan kaydı yok (Çalışanlar uygulaması).</div>
                        <div class="o_atlas_sf_grid o_atlas_sf_grid_sm">
                            <button t-foreach="this.state.operatorler" t-as="o" t-key="o.id" class="o_atlas_sf_tile text-center" t-on-click="() => this.operatorSec(o)">
                                <img t-att-src="o.avatar" class="o_atlas_sf_avatar mb-2" alt=""/>
                                <div class="fw-bold" t-out="o.ad"/>
                                <div class="small opacity-75" t-out="o.unvan"/>
                            </button>
                        </div>
                    </t>
                </t>

                <!-- İş emri listesi -->
                <t t-elif="this.state.ekran === 'liste'">
                    <div class="d-flex align-items-center mb-3 gap-2">
                        <h4 class="m-0 me-auto">İş emirleri</h4>
                        <button t-if="this.merkezDurusta" class="btn btn-lg btn-success" t-on-click="() => this.durusBitir()">Duruşu Bitir</button>
                        <button t-else="" class="btn btn-lg btn-outline-danger" t-on-click="() => this.panelAc('durus')">Duruş Bildir</button>
                    </div>
                    <div t-if="this.merkezDurusta" class="alert alert-danger fs-5">İş merkezi duruşta.</div>
                    <div t-if="!this.state.liste.is_emirleri.length" class="text-muted fs-5 py-5 text-center">Bu iş merkezinde açık iş emri yok.</div>
                    <div class="o_atlas_sf_list">
                        <button t-foreach="this.state.liste.is_emirleri" t-as="w" t-key="w.id" class="o_atlas_sf_card"
                                t-att-class="{ 'o_atlas_sf_running': w.calisiyor }" t-on-click="() => this.woAc(w.id)">
                            <div class="d-flex justify-content-between">
                                <span class="fw-bold fs-5" t-out="w.uretim"/>
                                <span class="badge" t-att-class="w.calisiyor ? 'text-bg-success' : w.durum === 'ready' ? 'text-bg-primary' : 'text-bg-secondary'" t-out="w.durum_ad"/>
                            </div>
                            <div class="fs-5" t-out="w.urun"/>
                            <div class="d-flex justify-content-between text-muted">
                                <span><t t-out="w.ad"/></span>
                                <span><t t-out="w.uretilen"/> / <t t-out="w.miktar"/> <t t-out="w.birim"/></span>
                            </div>
                        </button>
                    </div>
                </t>

                <!-- İş emri -->
                <t t-elif="this.state.ekran === 'wo'">
                    <t t-set="wo" t-value="this.state.wo"/>
                    <div class="row g-3">
                        <div class="col-lg-8">
                            <div class="o_atlas_sf_panel mb-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="text-muted"><t t-out="wo.uretim.ad"/> · <t t-out="wo.ad"/></div>
                                        <h3 class="m-0" t-out="wo.urun"/>
                                    </div>
                                    <span class="badge fs-6" t-att-class="wo.calisiyor ? 'text-bg-success' : 'text-bg-secondary'" t-out="wo.calisiyor ? 'Çalışıyor' : wo.durum_ad"/>
                                </div>
                                <div class="fs-5 mt-2">Üretilecek: <b><t t-out="wo.miktar"/> <t t-out="wo.birim"/></b> · Üretilen: <b t-out="wo.uretilen"/>
                                    <t t-if="wo.hatali"> · Hatalı: <b class="text-danger" t-out="wo.hatali"/></t></div>
                            </div>
                            <div t-if="wo.talimat" class="o_atlas_sf_panel mb-3">
                                <h5>Talimat</h5>
                                <div class="fs-5" t-out="wo.talimat"/>
                            </div>
                            <div t-if="wo.bilesenler.length" class="o_atlas_sf_panel mb-3">
                                <h5>Bileşenler</h5>
                                <table class="table align-middle mb-0">
                                    <thead><tr><th>Ürün</th><th class="text-end">Gereken</th><th class="text-end" style="width: 9rem;">Tüketilen</th></tr></thead>
                                    <tbody>
                                        <tr t-foreach="wo.bilesenler" t-as="b" t-key="b.id" t-att-class="{ 'table-warning': !b.hazir }">
                                            <td><t t-out="b.urun"/> <span t-if="!b.hazir" class="badge text-bg-warning">Stok yok</span></td>
                                            <td class="text-end"><t t-out="b.gereken"/> <t t-out="b.birim"/></td>
                                            <td class="text-end">
                                                <input t-if="b.takip === 'none' and wo.durum !== 'done'" type="number" step="any" class="form-control form-control-lg text-end"
                                                       t-att-value="b.tuketilen" t-on-change="(ev) => this.tuketim(b, ev)"/>
                                                <span t-else="" t-out="b.tuketilen"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div t-if="wo.kalite.length" class="o_atlas_sf_panel mb-3">
                                <h5>Kalite kontrol adımları</h5>
                                <div t-foreach="wo.kalite" t-as="k" t-key="k.id" class="d-flex align-items-center gap-2 py-2 border-bottom">
                                    <span class="badge" t-att-class="k.durum === 'gecti' ? 'text-bg-success' : k.durum === 'kaldi' ? 'text-bg-danger' : 'text-bg-warning'"
                                          t-out="k.durum === 'gecti' ? 'Geçti' : k.durum === 'kaldi' ? 'Kaldı' : 'Bekliyor'"/>
                                    <span class="fs-5 me-auto" t-out="k.nokta"/>
                                    <t t-if="k.durum === 'bekliyor'">
                                        <t t-if="k.tip === 'gecti_kaldi'">
                                            <button class="btn btn-lg btn-success" t-on-click="() => this.kalite(k, 'gecti')">Geçti</button>
                                            <button class="btn btn-lg btn-danger" t-on-click="() => this.kalite(k, 'kaldi')">Kaldı</button>
                                        </t>
                                        <button t-elif="k.tip === 'talimat'" class="btn btn-lg btn-success" t-on-click="() => this.kalite(k, 'gecti')">Uygulandı</button>
                                        <t t-elif="k.tip === 'olcum'">
                                            <input type="number" step="any" class="form-control form-control-lg" style="max-width: 9rem;" placeholder="Ölçüm"
                                                   t-on-change="(ev) => this.kaliteDeger(k, ev)"/>
                                            <button class="btn btn-lg btn-primary" t-on-click="() => this.kalite(k, 'degerlendir')">Kaydet</button>
                                        </t>
                                        <button t-else="" class="btn btn-lg btn-outline-primary" t-on-click="() => this.kaliteFormAc(k)">Aç</button>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <!-- Sağ: sayaç ve işlemler -->
                        <div class="col-lg-4">
                            <div class="o_atlas_sf_panel text-center mb-3">
                                <div class="text-muted">Süre</div>
                                <div class="o_atlas_sf_timer" t-att-class="{ 'text-danger': wo.planlanan_dk and this.gecenDk > wo.planlanan_dk }" t-out="this.sure(this.gecenDk)"/>
                                <div class="text-muted">Planlanan: <t t-out="this.sure(wo.planlanan_dk)"/></div>
                                <div class="progress mt-2" style="height: 0.6rem;">
                                    <div class="progress-bar" t-att-class="this.gecenDk > wo.planlanan_dk ? 'bg-danger' : 'bg-success'" t-att-style="'width:' + this.ilerleme + '%'"/>
                                </div>
                                <div t-if="wo.operatorler.length" class="small mt-2">Çalışan: <t t-out="wo.operatorler.join(', ')"/></div>
                            </div>
                            <div t-if="this.merkezDurusta" class="alert alert-danger fs-5 text-center">İş merkezi duruşta
                                <button class="btn btn-success w-100 mt-2" t-on-click="() => this.durusBitir()">Duruşu Bitir</button>
                            </div>
                            <div class="d-grid gap-2">
                                <t t-if="wo.durum !== 'done' and wo.durum !== 'cancel'">
                                    <button t-if="!wo.calisiyor" class="btn btn-success o_atlas_sf_big" t-att-disabled="this.merkezDurusta" t-on-click="() => this.baslat()">
                                        <i class="oi" data-icon="play_arrow"/> Başlat</button>
                                    <button t-else="" class="btn btn-warning o_atlas_sf_big" t-on-click="() => this.duraklat()"><i class="oi" data-icon="pause"/> Duraklat</button>
                                    <button class="btn btn-primary o_atlas_sf_big" t-on-click="() => this.panelAc('miktar')"><i class="oi" data-icon="check"/> Bitir</button>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-outline-secondary flex-fill btn-lg" t-on-click="() => this.panelAc('hurda')">Hurda</button>
                                        <button class="btn btn-outline-danger flex-fill btn-lg" t-on-click="() => this.panelAc('sorun')">Sorun</button>
                                        <button class="btn btn-outline-danger flex-fill btn-lg" t-att-disabled="this.merkezDurusta" t-on-click="() => this.panelAc('durus')">Duruş</button>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="alert alert-success fs-5 text-center mb-0">İş emri tamamlandı</div>
                                    <button t-if="wo.son_islem and wo.uretim.durum !== 'done'" class="btn btn-success o_atlas_sf_big" t-on-click="() => this.uretimiTamamla()">Üretimi Tamamla</button>
                                    <button class="btn btn-outline-primary btn-lg" t-on-click="() => this.listeAc()">İş emirlerine dön</button>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>
            </main>

            <!-- Paneller -->
            <div t-if="this.state.panel" class="o_atlas_sf_overlay" t-on-click.self="() => this.panelKapat()">
                <div class="o_atlas_sf_sheet">
                    <t t-if="this.state.panel === 'miktar'">
                        <h4>İş emrini bitir</h4>
                        <label class="form-label fs-5 mt-2">Üretilen (sağlam) adet</label>
                        <input type="number" step="any" class="form-control form-control-lg" t-att-value="this.state.form.uretilen" t-on-change="(ev) => this.deger('uretilen', ev)"/>
                        <label class="form-label fs-5 mt-2">Hatalı adet</label>
                        <input type="number" step="any" class="form-control form-control-lg" t-att-value="this.state.form.hatali" t-on-change="(ev) => this.deger('hatali', ev)"/>
                        <div class="d-flex gap-2 mt-3">
                            <button class="btn btn-lg btn-outline-primary flex-fill" t-on-click="() => this.miktarKaydet(false)">Yalnızca Kaydet</button>
                            <button class="btn btn-lg btn-primary flex-fill" t-on-click="() => this.miktarKaydet(true)">Bitir</button>
                        </div>
                    </t>
                    <t t-elif="this.state.panel === 'hurda'">
                        <h4>Hurda</h4>
                        <select class="form-select form-select-lg mt-2" t-on-change="(ev) => this.deger('product_id', ev)">
                            <option t-foreach="this.state.wo.hurda_urunleri" t-as="u" t-key="u.id" t-att-value="u.id" t-out="u.ad"/>
                        </select>
                        <input type="number" step="any" class="form-control form-control-lg mt-2" placeholder="Miktar" t-att-value="this.state.form.miktar" t-on-change="(ev) => this.deger('miktar', ev)"/>
                        <input type="text" class="form-control form-control-lg mt-2" placeholder="Neden (isteğe bağlı)" t-on-change="(ev) => this.deger('neden', ev)"/>
                        <button class="btn btn-lg btn-danger w-100 mt-3" t-on-click="() => this.hurdaKaydet()">Hurdaya Ayır</button>
                    </t>
                    <t t-elif="this.state.panel === 'sorun'">
                        <h4>Sorun bildir</h4>
                        <input type="text" class="form-control form-control-lg mt-2" placeholder="Kısa başlık" t-on-change="(ev) => this.deger('baslik', ev)"/>
                        <textarea class="form-control form-control-lg mt-2" rows="3" placeholder="Açıklama" t-on-change="(ev) => this.deger('aciklama', ev)"/>
                        <button class="btn btn-lg btn-danger w-100 mt-3" t-on-click="() => this.sorunKaydet()">Uygunsuzluk Aç</button>
                    </t>
                    <t t-elif="this.state.panel === 'durus'">
                        <h4>Duruş bildir</h4>
                        <div class="d-grid gap-2 mt-2">
                            <button t-foreach="this.state.liste.kayip_nedenleri" t-as="l" t-key="l.id" class="btn btn-lg text-start"
                                    t-att-class="this.durusSecili(l) ? 'btn-danger' : 'btn-outline-secondary'"
                                    t-on-click="() => this.durusSec(l)" t-out="l.ad"/>
                        </div>
                        <input type="text" class="form-control form-control-lg mt-2" placeholder="Açıklama" t-on-change="(ev) => this.deger('aciklama', ev)"/>
                        <button class="btn btn-lg btn-danger w-100 mt-3" t-on-click="() => this.durusKaydet()">Duruşu Başlat</button>
                    </t>
                    <button class="btn btn-link w-100 mt-2" t-on-click="() => this.panelKapat()">Vazgeç</button>
                </div>
            </div>
        </div>
    </t>

</templates>
