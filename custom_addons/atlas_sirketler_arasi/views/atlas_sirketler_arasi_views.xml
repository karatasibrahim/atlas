<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_sirketler_arasi" model="ir.ui.view">
        <field name="name">res.company.form.sirketler.arasi</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Şirketler Arası" name="sirketler_arasi">
                    <p class="text-muted">
                        Bu ayarlar, grup şirketlerinin <b>bu şirkete</b> kestiği belgeler için geçerlidir: belge onaylanınca
                        karşılığı burada oluşturulur.
                    </p>
                    <group>
                        <group string="Faturalar">
                            <field name="sa_fatura"/>
                            <field name="sa_fatura_durum" invisible="not sa_fatura" widget="radio" options="{'horizontal': true}"/>
                        </group>
                        <group string="Siparişler">
                            <field name="sa_satis_olustur"/>
                            <field name="sa_satin_alma_olustur"/>
                            <field name="sa_otomatik_onay" invisible="not sa_satis_olustur and not sa_satin_alma_olustur"/>
                            <field name="sa_depo_id" invisible="not sa_satis_olustur and not sa_satin_alma_olustur" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="sa_kullanici_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_sirketler_arasi" model="ir.ui.view">
        <field name="name">account.move.form.sirketler.arasi</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="sa_kaynak_fatura_id" invisible="not sa_kaynak_fatura_id" readonly="1" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_sirketler_arasi" model="ir.ui.view">
        <field name="name">sale.order.form.sirketler.arasi</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="sa_kaynak_satin_alma_id" invisible="not sa_kaynak_satin_alma_id" readonly="1" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_form_sirketler_arasi" model="ir.ui.view">
        <field name="name">purchase.order.form.sirketler.arasi</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="sa_kaynak_satis_id" invisible="not sa_kaynak_satis_id" readonly="1" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_view_form_sirketler_arasi" model="ir.ui.view">
        <field name="name">res.config.settings.sirketler.arasi</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='companies_setting']" position="after">
                <setting id="atlas_sirketler_arasi" string="Şirketler Arası İşlemler" company_dependent="1" groups="base.group_multi_company"
                         help="Grup şirketlerinin bu şirkete kestiği belgelerin karşılığını burada otomatik oluştur">
                    <div class="content-group mt-2">
                        <div class="d-flex gap-2"><field name="sa_fatura"/><label for="sa_fatura" class="o_light_label"/></div>
                        <div class="ms-4" invisible="not sa_fatura">
                            <field name="sa_fatura_durum" widget="radio" options="{'horizontal': true}"/>
                        </div>
                        <div class="d-flex gap-2"><field name="sa_satis_olustur"/><label for="sa_satis_olustur" class="o_light_label"/></div>
                        <div class="d-flex gap-2"><field name="sa_satin_alma_olustur"/><label for="sa_satin_alma_olustur" class="o_light_label"/></div>
                        <div class="ms-4" invisible="not sa_satis_olustur and not sa_satin_alma_olustur">
                            <div class="d-flex gap-2"><field name="sa_otomatik_onay"/><label for="sa_otomatik_onay" class="o_light_label"/></div>
                            <div class="row mt-1"><label for="sa_depo_id" class="col-4 o_light_label"/><field name="sa_depo_id" class="col" options="{'no_create': True}"/></div>
                        </div>
                        <div class="row mt-1"><label for="sa_kullanici_id" class="col-4 o_light_label"/><field name="sa_kullanici_id" class="col" options="{'no_create': True}"/></div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
