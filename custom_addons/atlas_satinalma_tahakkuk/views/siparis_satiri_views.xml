<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <function model="res.company" name="_atlas_tahakkuk_kur"/>
    <record id="view_satir_tahakkuk_list" model="ir.ui.view">
        <field name="name">purchase.order.line.tahakkuk.list</field>
        <field name="model">purchase.order.line</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="order_id"/>
                <field name="partner_id" string="Tedarikçi"/>
                <field name="product_id"/>
                <field name="name" optional="hide"/>
                <field name="date_order" optional="show"/>
                <field name="qty_received"/>
                <field name="qty_invoiced"/>
                <field name="atlas_tahakkuk_miktar"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="atlas_tahakkuk_tutar" sum="Toplam"/>
            </list>
        </field>
    </record>
    <record id="view_satir_tahakkuk_search" model="ir.ui.view">
        <field name="name">purchase.order.line.tahakkuk.search</field>
        <field name="model">purchase.order.line</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <filter name="son_365" string="Son 365 gün" domain="[('order_id.date_order', '&gt;=', (context_today() - relativedelta(days=365)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="groupby_vendor" string="Tedarikçi" context="{'group_by': 'partner_id'}"/>
                    <filter name="g_siparis" string="Sipariş" context="{'group_by': 'order_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <menuitem id="menu_tahakkuk_ust" name="Satınalma" parent="account.account_audit_menu" sequence="30"/>
    <record id="action_fatura_gelecek" model="ir.actions.act_window">
        <field name="name">Faturası Gelecek Alımlar</field>
        <field name="res_model">purchase.order.line</field>
        <field name="view_mode">list</field>
        <field name="domain">[('atlas_fatura_gelecek', '=', True)]</field>
        <field name="context">{'accrual_type': 'bill_to_receive', 'search_default_son_365': 1, 'search_default_groupby_vendor': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_satir_tahakkuk_list')})]"/>
        <field name="search_view_id" ref="view_satir_tahakkuk_search"/>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Kayıt yok</p><p>Teslim alındı, tedarikçi faturası henüz gelmedi (dönem sonu gider tahakkuku). Satırları seçip "İşlem › Tahakkuk Kaydı" ile dönem sonu tahakkuk fişi oluşturabilirsiniz.</p></field>
    </record>
    <menuitem id="menu_fatura_gelecek" name="Faturası Gelecek Alımlar" parent="menu_tahakkuk_ust" action="action_fatura_gelecek" sequence="1"/>
    <record id="action_teslim_alinmamis" model="ir.actions.act_window">
        <field name="name">Faturalanıp Teslim Alınmayan</field>
        <field name="res_model">purchase.order.line</field>
        <field name="view_mode">list</field>
        <field name="domain">[('atlas_teslim_alinmamis', '=', True)]</field>
        <field name="context">{'accrual_type': 'billed_not_received', 'search_default_son_365': 1, 'search_default_groupby_vendor': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_satir_tahakkuk_list')})]"/>
        <field name="search_view_id" ref="view_satir_tahakkuk_search"/>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Kayıt yok</p><p>Fatura geldi, mal/hizmet henüz teslim alınmadı (peşin ödenmiş gider). Satırları seçip "İşlem › Tahakkuk Kaydı" ile dönem sonu tahakkuk fişi oluşturabilirsiniz.</p></field>
    </record>
    <menuitem id="menu_teslim_alinmamis" name="Faturalanıp Teslim Alınmayan" parent="menu_tahakkuk_ust" action="action_teslim_alinmamis" sequence="2"/>
</odoo>
