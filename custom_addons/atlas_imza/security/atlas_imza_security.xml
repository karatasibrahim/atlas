<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_imza">
        <field name="name">e-İmza</field>
        <field name="sequence">45</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>
    <record id="group_imza_user" model="res.groups">
        <field name="name">Kullanıcı: Kendi Talepleri</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_imza"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_imza_manager" model="res.groups">
        <field name="name">Yönetici: Tüm Talepler</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_imza"/>
        <field name="implied_ids" eval="[(4, ref('group_imza_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_imza_user'))]"/>
    </record>
</odoo>
