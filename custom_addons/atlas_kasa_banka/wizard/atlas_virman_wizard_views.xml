<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_atlas_virman_wizard_form" model="ir.ui.view">
        <field name="name">atlas.virman.wizard.form</field>
        <field name="model">atlas.virman.wizard</field>
        <field name="arch" type="xml">
            <form string="Virman">
                <group>
                    <group>
                        <field name="company_id" invisible="1"/>
                        <field name="kaynak_currency_id" invisible="1"/>
                        <field name="hedef_currency_id" invisible="1"/>
                        <field name="farkli_doviz" invisible="1"/>
                        <field name="date"/>
                        <field name="kaynak_journal_id" options="{'no_create': True}"/>
                        <field name="hedef_journal_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="amount"/>
                        <field name="hedef_amount" invisible="not farkli_doviz"/>
                        <field name="aciklama"/>
                        <field name="ref"/>
                    </group>
                </group>
                <p class="text-muted">
                    Banka ayağı transit hesaba yazılır ve banka ekstresi yüklendiğinde eşleştirme ekranında bu virmanla kapatılır.
                </p>
                <footer>
                    <button name="action_create" type="object" string="Virmanı Kaydet" class="btn-primary"/>
                    <button string="Vazgeç" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_atlas_virman_wizard" model="ir.actions.act_window">
        <field name="name">Virman</field>
        <field name="res_model">atlas.virman.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
