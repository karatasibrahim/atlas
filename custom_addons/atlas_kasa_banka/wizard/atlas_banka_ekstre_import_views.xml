<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_atlas_banka_ekstre_import_form" model="ir.ui.view">
        <field name="name">atlas.banka.ekstre.import.form</field>
        <field name="model">atlas.banka.ekstre.import</field>
        <field name="arch" type="xml">
            <form string="Banka Ekstresi Yükle">
                <group>
                    <field name="journal_id" options="{'no_create': True}"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="sablon_id" options="{'no_create': True}" placeholder="Otomatik algıla"/>
                    <field name="oner"/>
                </group>
                <p class="text-muted">
                    Bankanızın internet şubesinden indirdiğiniz .xlsx ekstre dosyasını seçin. Daha önce aktarılmış hareketler atlanır.
                </p>
                <footer>
                    <button name="action_import" type="object" string="İçe Aktar" class="btn-primary"/>
                    <button string="Vazgeç" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_atlas_banka_ekstre_import" model="ir.actions.act_window">
        <field name="name">Banka Ekstresi Yükle</field>
        <field name="res_model">atlas.banka.ekstre.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
