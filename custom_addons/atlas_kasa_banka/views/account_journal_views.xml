<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_atlas_kasa_banka_journal_list" model="ir.ui.view">
        <field name="name">account.journal.list.atlas.kasa.banka</field>
        <field name="model">account.journal</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list string="Kasa / Banka Hesapları">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="type" column_invisible="1"/>
                <field name="bank_name" string="Banka" optional="show" column_invisible="context.get('default_type') == 'cash'"/>
                <field name="bank_account_number" string="IBAN" optional="show" column_invisible="context.get('default_type') == 'cash'"/>
                <field name="default_account_id" string="Muhasebe Hesabı"/>
                <field name="atlas_currency_id" string="Para Birimi"/>
                <field name="atlas_company_currency_id" column_invisible="1"/>
                <field name="atlas_bakiye" decoration-danger="atlas_bakiye &lt; 0"/>
                <field name="atlas_bakiye_tl" sum="Toplam (TL)" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_atlas_kasa_banka_journal_form" model="ir.ui.view">
        <field name="name">account.journal.form.atlas.kasa.banka</field>
        <field name="model">account.journal</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <form string="Kasa / Banka Hesabı">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_atlas_hareketler" type="object" class="oe_stat_button" icon="fa-exchange">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="atlas_bakiye" widget="monetary" options="{'currency_field': 'atlas_currency_id'}"/>
                                </span>
                                <span class="o_stat_text">Hareketler</span>
                            </div>
                        </button>
                        <button name="action_atlas_ekstre_yukle" type="object" class="oe_stat_button" icon="fa-upload"
                                string="Ekstre Yükle" invisible="type != 'bank'"/>
                        <button name="action_atlas_eslestirme" type="object" class="oe_stat_button" icon="fa-link"
                                string="Eşleştirme" invisible="type != 'bank'"/>
                    </div>
                    <widget name="web_ribbon" title="Arşivlendi" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="ör. TL Kasa, Garanti TL Vadesiz"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="type" invisible="1"/>
                            <field name="active" invisible="1"/>
                            <field name="code" string="Kısa Kod"/>
                            <field name="currency_id" string="Para Birimi" placeholder="TL (şirket para birimi)"
                                   readonly="default_account_id" options="{'no_create': True}"/>
                            <field name="default_account_id" string="Muhasebe Hesabı" readonly="1" invisible="not default_account_id"/>
                            <field name="atlas_currency_id" invisible="1"/>
                            <field name="atlas_company_currency_id" invisible="1"/>
                            <field name="atlas_bakiye_tl" invisible="not currency_id"/>
                        </group>
                        <group invisible="type != 'bank'">
                            <field name="bank_account_number" string="IBAN" placeholder="TR00 0000 0000 0000 0000 0000 00"/>
                            <field name="bank_name" string="Banka" placeholder="IBAN'dan otomatik"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <div class="text-muted" invisible="default_account_id">
                        Kaydedince muhasebe hesabı otomatik açılır (kasa 100, banka 102 altında), döviz seçildiyse o dövizde.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_atlas_kasa" model="ir.actions.act_window">
        <field name="name">Kasalar</field>
        <field name="res_model">account.journal</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('type', '=', 'cash')]</field>
        <field name="context">{'default_type': 'cash'}</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('view_atlas_kasa_banka_journal_list')}),
            Command.create({'view_mode': 'form', 'view_id': ref('view_atlas_kasa_banka_journal_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Kasa tanımlayın</p>
            <p>TL ve döviz kasaları için ayrı kasa açın; her kasanın 100 altında kendi hesabı olur.</p>
        </field>
    </record>

    <record id="action_atlas_banka" model="ir.actions.act_window">
        <field name="name">Banka Hesapları</field>
        <field name="res_model">account.journal</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('type', '=', 'bank')]</field>
        <field name="context">{'default_type': 'bank'}</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('view_atlas_kasa_banka_journal_list')}),
            Command.create({'view_mode': 'form', 'view_id': ref('view_atlas_kasa_banka_journal_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Banka hesabı tanımlayın</p>
            <p>Her banka hesabı (TL/döviz) için IBAN ile bir kayıt açın; 102 altında hesabı otomatik açılır.</p>
        </field>
    </record>
</odoo>
