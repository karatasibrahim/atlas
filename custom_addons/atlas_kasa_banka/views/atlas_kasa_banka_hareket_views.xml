<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_atlas_kasa_banka_hareket_list" model="ir.ui.view">
        <field name="name">atlas.kasa.banka.hareket.list</field>
        <field name="model">atlas.kasa.banka.hareket</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" action="action_open_move" type="object">
                <field name="date"/>
                <field name="journal_id"/>
                <field name="hareket_turu"/>
                <field name="move_name"/>
                <field name="evrak_no" optional="show"/>
                <field name="aciklama" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_currency_id" column_invisible="1"/>
                <field name="giris" sum="Toplam Giriş"/>
                <field name="cikis" sum="Toplam Çıkış"/>
                <field name="bakiye" decoration-danger="bakiye &lt; 0"/>
                <field name="tutar_tl" optional="hide" sum="TL"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_atlas_kasa_banka_hareket_search" model="ir.ui.view">
        <field name="name">atlas.kasa.banka.hareket.search</field>
        <field name="model">atlas.kasa.banka.hareket</field>
        <field name="arch" type="xml">
            <search>
                <field name="journal_id"/>
                <field name="partner_id"/>
                <field name="move_name"/>
                <field name="aciklama"/>
                <filter name="kasa" string="Kasalar" domain="[('journal_type', '=', 'cash')]"/>
                <filter name="banka" string="Bankalar" domain="[('journal_type', '=', 'bank')]"/>
                <separator/>
                <filter name="giris" string="Girişler" domain="[('tutar', '&gt;', 0)]"/>
                <filter name="cikis" string="Çıkışlar" domain="[('tutar', '&lt;', 0)]"/>
                <separator/>
                <filter name="date" string="Tarih" date="date"/>
                <group>
                    <filter name="group_by_journal" string="Kasa / Banka" context="{'group_by': 'journal_id'}"/>
                    <filter name="group_by_turu" string="Hareket Türü" context="{'group_by': 'hareket_turu'}"/>
                    <filter name="group_by_date" string="Gün" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_atlas_kasa_banka_hareket" model="ir.actions.act_window">
        <field name="name">Kasa / Banka Hareketleri</field>
        <field name="res_model">atlas.kasa.banka.hareket</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_atlas_kasa_banka_hareket_search"/>
        <field name="context">{'search_default_group_by_journal': 1}</field>
    </record>
</odoo>
