<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_atlas_cari_hareket_list" model="ir.ui.view">
        <field name="name">atlas.cari.hareket.list</field>
        <field name="model">atlas.cari.hareket</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="date, move_id, id"
                  action="action_open_move" type="object">
                <field name="date"/>
                <field name="cari_kodu" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="hareket_turu"/>
                <field name="move_name"/>
                <field name="evrak_no" optional="show"/>
                <field name="aciklama" optional="show"/>
                <field name="date_maturity" optional="show"/>
                <field name="account_id" optional="hide"/>
                <field name="journal_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="company_currency_id" column_invisible="1"/>
                <field name="debit" sum="Toplam Borç"/>
                <field name="credit" sum="Toplam Alacak"/>
                <field name="bakiye" decoration-danger="bakiye &lt; 0"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount_currency" optional="hide" invisible="not currency_id or currency_id == company_currency_id"/>
                <field name="amount_residual" optional="hide"/>
                <field name="reconciled" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_atlas_cari_hareket_pivot" model="ir.ui.view">
        <field name="name">atlas.cari.hareket.pivot</field>
        <field name="model">atlas.cari.hareket</field>
        <field name="arch" type="xml">
            <pivot string="Cari Hareketleri">
                <field name="partner_id" type="row"/>
                <field name="hareket_turu" type="col"/>
                <field name="balance" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_atlas_cari_hareket_search" model="ir.ui.view">
        <field name="name">atlas.cari.hareket.search</field>
        <field name="model">atlas.cari.hareket</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="cari_kodu"/>
                <field name="move_name"/>
                <field name="evrak_no"/>
                <field name="aciklama"/>
                <field name="account_id"/>
                <filter name="alici" string="Alıcı (120)" domain="[('account_id.account_type', '=', 'asset_receivable')]"/>
                <filter name="satici" string="Satıcı (320)" domain="[('account_id.account_type', '=', 'liability_payable')]"/>
                <separator/>
                <filter name="fatura" string="Faturalar" domain="[('hareket_turu', 'in', ('satis_fatura', 'satis_iade', 'alis_fatura', 'alis_iade'))]"/>
                <filter name="tahsilat_odeme" string="Tahsilat / Ödeme" domain="[('hareket_turu', 'in', ('tahsilat', 'odeme', 'banka', 'fis_tahsil', 'fis_tediye'))]"/>
                <filter name="mahsup" string="Mahsup / Dekont" domain="[('hareket_turu', 'in', ('mahsup', 'fis_dekont', 'fis_acilis', 'fis_kapanis'))]"/>
                <separator/>
                <filter name="acik" string="Açık Kalemler" domain="[('reconciled', '=', False)]"/>
                <filter name="vadesi_gecmis" string="Vadesi Geçmiş" domain="[('reconciled', '=', False), ('date_maturity', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="date" string="Tarih" date="date"/>
                <group>
                    <filter name="group_by_partner" string="Cari" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_by_turu" string="Hareket Türü" context="{'group_by': 'hareket_turu'}"/>
                    <filter name="group_by_date" string="Ay" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_atlas_cari_hareket" model="ir.actions.act_window">
        <field name="name">Cari Hareketleri</field>
        <field name="res_model">atlas.cari.hareket</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_atlas_cari_hareket_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">Henüz onaylanmış cari hareketi yok</p>
            <p>Faturalar, tahsilat/ödemeler ve mahsup fişleri onaylandığında burada listelenir.</p>
        </field>
    </record>
</odoo>
