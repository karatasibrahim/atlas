<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_atlas_cari_ekstre_wizard_form" model="ir.ui.view">
        <field name="name">atlas.cari.ekstre.wizard.form</field>
        <field name="model">atlas.cari.ekstre.wizard</field>
        <field name="arch" type="xml">
            <form string="Cari Ekstre">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="show_currency"/>
                        <field name="hide_empty"/>
                    </group>
                </group>
                <field name="partner_ids" widget="many2many_tags" options="{'no_create': True}"
                       placeholder="Cari seçin..."/>
                <footer>
                    <button name="action_print_pdf" type="object" string="PDF" class="btn-primary" icon="fa-file-pdf-o"/>
                    <button name="action_export_xlsx" type="object" string="Excel" class="btn-secondary" icon="fa-file-excel-o"/>
                    <button name="action_print_html" type="object" string="Ekranda Göster" class="btn-secondary" icon="fa-eye"/>
                    <button string="Vazgeç" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_atlas_cari_ekstre_wizard" model="ir.actions.act_window">
        <field name="name">Cari Ekstre</field>
        <field name="res_model">atlas.cari.ekstre.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
