<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_plm">
        <field name="name">PLM</field>
        <field name="sequence">7</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>
    <record id="group_plm_user" model="res.groups">
        <field name="name">PLM Kullanıcısı</field>
        <field name="sequence">10</field>
        <field name="comment">Değişiklik emri açar, revizyon hazırlar, kendisine atanan onayları verir.</field>
        <field name="privilege_id" ref="res_groups_privilege_plm"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_plm_manager" model="res.groups">
        <field name="name">PLM Yöneticisi</field>
        <field name="sequence">20</field>
        <field name="comment">Tipleri, aşamaları ve onay şablonlarını yönetir; şablonda kişi yoksa onay verir.</field>
        <field name="privilege_id" ref="res_groups_privilege_plm"/>
        <field name="implied_ids" eval="[(4, ref('group_plm_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
