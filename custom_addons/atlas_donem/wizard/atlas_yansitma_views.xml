<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_atlas_yansitma_wizard_form" model="ir.ui.view">
        <field name="name">atlas.yansitma.wizard.form</field>
        <field name="model">atlas.yansitma.wizard</field>
        <field name="arch" type="xml">
            <form string="7/A Gider Yansıtma">
                <group>
                    <field name="date"/>
                    <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                </group>
                <field name="ozet"/>
                <p class="text-muted">
                    Yıl başından seçilen tarihe kadar oluşan ve henüz yansıtılmamış giderler aktarılır:
                    üretim giderleri (710/720/730) 151 Yarı Mamuller'e, faaliyet giderleri (750/760/770/780) 630/631/632/660'a.
                    Karşılıkları ilgili yansıtma hesaplarına (711/721/731, 751/761/771/781) yazılır.
                </p>
                <footer>
                    <button name="action_yansit" type="object" string="Yansıtma Fişini Oluştur" class="btn-primary"/>
                    <button string="Kapat" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_atlas_yansitma" model="ir.actions.act_window">
        <field name="name">7/A Gider Yansıtma</field>
        <field name="res_model">atlas.yansitma.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
