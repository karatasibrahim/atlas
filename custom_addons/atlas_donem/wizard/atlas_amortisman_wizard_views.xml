<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_atlas_amortisman_wizard_form" model="ir.ui.view">
        <field name="name">atlas.amortisman.wizard.form</field>
        <field name="model">atlas.amortisman.wizard</field>
        <field name="arch" type="xml">
            <form string="Amortisman Kaydı">
                <group>
                    <field name="date"/>
                    <field name="kiymet_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="Tüm aktif kıymetler"/>
                    <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                </group>
                <field name="ozet"/>
                <footer>
                    <button name="action_kaydet" type="object" string="Amortisman Fişini Oluştur" class="btn-primary"/>
                    <button string="Kapat" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_atlas_amortisman_wizard" model="ir.actions.act_window">
        <field name="name">Amortisman Kaydı</field>
        <field name="res_model">atlas.amortisman.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
