<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_destek">
        <field name="name">Yardım Masası</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>
    <record id="group_destek_user" model="res.groups">
        <field name="name">Destek Personeli</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_destek"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_destek_manager" model="res.groups">
        <field name="name">Yardım Masası Yöneticisi</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_destek"/>
        <field name="implied_ids" eval="[(4, ref('group_destek_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
