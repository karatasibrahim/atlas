<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_atlas_planlama_tekrar_form" model="ir.ui.view">
        <field name="name">atlas.planlama.tekrar.wizard.form</field>
        <field name="model">atlas.planlama.tekrar.wizard</field>
        <field name="arch" type="xml">
            <form string="Vardiyayı Tekrarla">
                <group>
                    <field name="vardiya_ids" widget="many2many_tags" readonly="1"/>
                    <field name="aralik" widget="radio"/>
                    <field name="adet"/>
                </group>
                <footer>
                    <button name="action_tekrarla" type="object" string="Oluştur" class="btn-primary"/>
                    <button special="cancel" string="Vazgeç"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
