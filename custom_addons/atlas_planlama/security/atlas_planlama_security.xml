<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_planlama">
        <field name="name">Planlama</field>
        <field name="sequence">8</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>
    <record id="group_planlama_manager" model="res.groups">
        <field name="name">Planlama Yöneticisi</field>
        <field name="sequence">20</field>
        <field name="comment">Vardiya planlar, yayınlar; roller ve şablonları yönetir. Diğer kullanıcılar yalnızca yayınlanan vardiyaları görür.</field>
        <field name="privilege_id" ref="res_groups_privilege_planlama"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
