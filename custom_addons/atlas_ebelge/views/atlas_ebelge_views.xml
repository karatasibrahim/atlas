<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_atlas_ebelge" model="ir.ui.view">
        <field name="name">account.move.form.atlas.ebelge</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <group id="header_right_group" position="inside">
                <field name="atlas_ebelge_tipi" invisible="move_type not in ('out_invoice', 'in_refund')" readonly="state != 'draft'"/>
                <field name="atlas_ebelge_senaryo" invisible="atlas_ebelge_tipi not in ('efatura', 'earsiv')" readonly="state != 'draft'"/>
                <field name="atlas_fatura_tipi" invisible="move_type not in ('out_invoice', 'in_refund') or atlas_ebelge_tipi == 'kagit'" readonly="state != 'draft'"/>
                <field name="atlas_ettn" invisible="not atlas_ettn"/>
            </group>
        </field>
    </record>

    <record id="view_out_invoice_list_atlas_ebelge" model="ir.ui.view">
        <field name="name">account.move.list.atlas.ebelge</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="invoice_partner_display_name" position="after">
                <field name="atlas_ebelge_tipi" optional="show"/>
                <field name="atlas_fatura_tipi" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_partner_form_atlas_ebelge" model="ir.ui.view">
        <field name="name">res.partner.form.atlas.ebelge</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <group name="general" position="after">
                <group string="e-Fatura" name="atlas_efatura" groups="account.group_account_invoice">
                    <field name="atlas_efatura_mukellef"/>
                    <field name="atlas_efatura_etiket" invisible="not atlas_efatura_mukellef"/>
                    <field name="atlas_efatura_senaryo" invisible="not atlas_efatura_mukellef" placeholder="Şirket varsayılanı"/>
                    <field name="atlas_efatura_kontrol" invisible="not atlas_efatura_mukellef"/>
                </group>
            </group>
        </field>
    </record>

    <record id="view_atlas_seri_form_ebelge" model="ir.ui.view">
        <field name="name">atlas.seri.form.ebelge</field>
        <field name="model">atlas.seri</field>
        <field name="inherit_id" ref="atlas_fis.view_atlas_seri_form"/>
        <field name="arch" type="xml">
            <field name="varsayilan" position="after">
                <field name="ebelge_tipi" placeholder="Tüm faturalar"/>
            </field>
        </field>
    </record>

    <record id="res_config_settings_view_form_atlas_ebelge" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.atlas.ebelge</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="invoicing_settings" position="before">
                <block title="e-Fatura / e-Arşiv" id="atlas_ebelge">
                    <setting string="e-Fatura / e-Arşiv kullanılıyor" company_dependent="1"
                             help="Giden faturalar alıcının mükellefiyetine göre e-Fatura veya e-Arşiv olarak işaretlenir, uygun seri seçilir ve ETTN üretilir">
                        <field name="atlas_ebelge_aktif"/>
                        <div class="content-group mt-2" invisible="not atlas_ebelge_aktif">
                            <div class="row">
                                <label for="atlas_efatura_senaryo" string="Varsayılan senaryo" class="col-lg-5 o_light_label"/>
                                <field name="atlas_efatura_senaryo" class="col-lg-7"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
