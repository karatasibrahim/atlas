<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_atlas_odeme_talimat_ekle_form" model="ir.ui.view">
        <field name="name">atlas.odeme.talimat.ekle.form</field>
        <field name="model">atlas.odeme.talimat.ekle</field>
        <field name="arch" type="xml">
            <form string="Ödeme Talimatına Ekle">
                <group>
                    <field name="talimat_id" placeholder="Yeni talimat aç" options="{'no_create': True}"/>
                    <field name="journal_id" invisible="talimat_id" required="not talimat_id" options="{'no_create': True}"/>
                    <field name="tarih" invisible="talimat_id"/>
                    <field name="move_ids" widget="many2many_tags" readonly="1"/>
                </group>
                <footer>
                    <button name="action_ekle" type="object" string="Ekle" class="btn-primary"/>
                    <button special="cancel" string="Vazgeç"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_atlas_odeme_talimat_ekle" model="ir.actions.act_window">
        <field name="name">Ödeme Talimatına Ekle</field>
        <field name="res_model">atlas.odeme.talimat.ekle</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
