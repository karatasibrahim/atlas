<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_atlas_ai" model="ir.ui.view">
        <field name="name">account.move.form.atlas.ai</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_atlas_ai_oku" type="object" string="AI ile Oku"
                        invisible="state != 'draft' or move_type == 'entry' or atlas_ai_durum == 'kuyrukta'"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info mb-0" role="status" invisible="atlas_ai_durum != 'okundu'">
                    Bu fatura yapay zekâyla okundu (güven %<field name="atlas_ai_guven" class="d-inline" readonly="1" digits="[3, 0]"/>).
                    Kaydetmeden önce cari, tarih, satır ve vergileri kontrol edin.
                </div>
                <div class="alert alert-secondary mb-0" role="status" invisible="atlas_ai_durum != 'kuyrukta'">Belge yapay zekâyla okunuyor…</div>
                <div class="alert alert-warning mb-0" role="alert" invisible="atlas_ai_durum != 'hata'">
                    Yapay zekâ okuması başarısız: <field name="atlas_ai_hata_mesaji" class="d-inline" readonly="1"/>
                </div>
                <field name="atlas_ai_durum" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
