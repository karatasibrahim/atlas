    <record id="view_move_form_atlas_onay" model="ir.ui.view">
        <field name="name">account.move.form.atlas.onay</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="atlas_onay_durumu" invisible="1"/>
