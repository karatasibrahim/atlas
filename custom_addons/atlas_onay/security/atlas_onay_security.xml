<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_onay">
        <field name="name">Onaylar</field>
        <field name="sequence">46</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>
    <record id="group_onay_user" model="res.groups">
        <field name="name">Kullanıcı</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_onay"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_onay_manager" model="res.groups">
        <field name="name">Yönetici</field>
        <field name="sequence">20</field>
        <field name="comment">Tüm talepleri görür; kategori ve kayıt onay kurallarını yönetir.</field>
        <field name="privilege_id" ref="res_groups_privilege_onay"/>
        <field name="implied_ids" eval="[(4, ref('group_onay_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_onay_user'))]"/>
    </record>
</odoo>
