<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_atlas_irsaliye_plaka_list" model="ir.ui.view">
        <field name="name">atlas.irsaliye.plaka.list</field>
        <field name="model">atlas.irsaliye.plaka</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="tip"/>
                <field name="tasiyici_id" placeholder="Kendi aracımız"/>
                <field name="sofor_id"/>
                <field name="aciklama"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="action_atlas_irsaliye_plaka" model="ir.actions.act_window">
        <field name="name">Plakalar</field>
        <field name="res_model">atlas.irsaliye.plaka</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_atlas_irsaliye_sofor_list" model="ir.ui.view">
        <field name="name">atlas.irsaliye.sofor.list</field>
        <field name="model">atlas.irsaliye.sofor</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="ad"/>
                <field name="soyad"/>
                <field name="tckn"/>
                <field name="telefon"/>
                <field name="tasiyici_id" placeholder="Kendi şoförümüz"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="action_atlas_irsaliye_sofor" model="ir.actions.act_window">
        <field name="name">Şoförler</field>
        <field name="res_model">atlas.irsaliye.sofor</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_picking_form_atlas_eirsaliye" model="ir.ui.view">
        <field name="name">stock.picking.form.atlas.eirsaliye</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="atlas_stok.view_picking_form_atlas_irsaliye"/>
        <field name="arch" type="xml">
            <page name="atlas_sevk" position="replace">
                <page string="Sevk Bilgileri" name="atlas_sevk" invisible="picking_type_code != 'outgoing'">
                    <group>
                        <group>
                            <field name="atlas_irsaliye_tipi" widget="radio"/>
                            <field name="atlas_matbu_no" invisible="atlas_irsaliye_tipi != 'MATBUDAN'"/>
                            <field name="atlas_matbu_tarih" invisible="atlas_irsaliye_tipi != 'MATBUDAN'"/>
                            <field name="atlas_fiili_sevk_tarihi"/>
                        </group>
                        <group invisible="atlas_irsaliye_tipi != 'SEVK'">
                            <field name="atlas_tasiyici_id" placeholder="Kendi aracımızla"/>
                            <field name="atlas_arac_id" options="{'no_quick_create': True}"/>
                            <field name="atlas_dorse_ids" widget="many2many_tags" options="{'no_quick_create': True}"/>
                            <field name="atlas_sofor_ids" widget="many2many_tags" options="{'no_quick_create': True}"/>
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>

    <record id="res_config_settings_view_form_atlas_eirsaliye" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.atlas.eirsaliye</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="atlas_stok.res_config_settings_view_form_atlas_stok"/>
        <field name="arch" type="xml">
            <block id="atlas_stok_muhasebesi" position="after">
                <block title="e-İrsaliye" id="atlas_eirsaliye">
                    <setting string="e-İrsaliye kullanılıyor" company_dependent="1"
                             help="Sevkiyat doğrulanırken alıcı VKN, plaka/şoför veya taşıyıcı firma zorunlu olur">
                        <field name="atlas_eirsaliye"/>
                        <div class="mt-2">
                            <button name="%(action_atlas_irsaliye_plaka)d" type="action" string="Plakalar" icon="oi-arrow-right" class="btn-link"/>
                            <button name="%(action_atlas_irsaliye_sofor)d" type="action" string="Şoförler" icon="oi-arrow-right" class="btn-link"/>
                        </div>
                    </setting>
                </block>
            </block>
        </field>
    </record>

    <menuitem id="menu_atlas_eirsaliye" name="e-İrsaliye" parent="stock.menu_stock_config_settings" sequence="90"
              groups="stock.group_stock_manager"/>
    <menuitem id="menu_atlas_eirsaliye_plaka" name="Plakalar" parent="menu_atlas_eirsaliye" action="action_atlas_irsaliye_plaka" sequence="10"/>
    <menuitem id="menu_atlas_eirsaliye_sofor" name="Şoförler" parent="menu_atlas_eirsaliye" action="action_atlas_irsaliye_sofor" sequence="20"/>
</odoo>
