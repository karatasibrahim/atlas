<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_atlas_gib_kod_list" model="ir.ui.view">
        <field name="name">atlas.gib.kod.list</field>
        <field name="model">atlas.gib.kod</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="kod"/>
                <field name="name"/>
                <field name="tip"/>
                <field name="tevkifat_pay"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_atlas_gib_kod_search" model="ir.ui.view">
        <field name="name">atlas.gib.kod.search</field>
        <field name="model">atlas.gib.kod</field>
        <field name="arch" type="xml">
            <search>
                <field name="kod"/>
                <field name="name"/>
                <group><filter name="group_by_tip" string="Tip" context="{'group_by': 'tip'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_atlas_gib_kod" model="ir.actions.act_window">
        <field name="name">GİB İstisna / Tevkifat Kodları</field>
        <field name="res_model">atlas.gib.kod</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_by_tip': 1}</field>
    </record>

    <record id="view_account_position_form_atlas" model="ir.ui.view">
        <field name="name">account.fiscal.position.form.atlas</field>
        <field name="model">account.fiscal.position</field>
        <field name="inherit_id" ref="account.view_account_position_form"/>
        <field name="arch" type="xml">
            <field name="country_id" position="after">
                <field name="atlas_gib_kod_id" options="{'no_create': True}"/>
            </field>
        </field>
    </record>

    <record id="view_tax_form_atlas" model="ir.ui.view">
        <field name="name">account.tax.form.atlas</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <field name="type_tax_use" position="after">
                <field name="atlas_gib_kod_id" options="{'no_create': True}"/>
            </field>
        </field>
    </record>

    <record id="view_move_form_atlas_kur_tipi" model="ir.ui.view">
        <field name="name">account.move.form.atlas.kur.tipi</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='journal_div']" position="after">
                <field name="atlas_kur_tipi" invisible="currency_id == company_currency_id or move_type == 'entry'"
                       readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>

    <record id="view_partner_property_form_atlas_kur" model="ir.ui.view">
        <field name="name">res.partner.form.atlas.kur.tipi</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <group name="sale" position="inside">
                <field name="atlas_satis_kur_tipi" groups="account.group_account_invoice"/>
            </group>
            <group name="purchase" position="inside">
                <field name="atlas_alis_kur_tipi" groups="account.group_account_invoice"/>
            </group>
        </field>
    </record>
</odoo>
