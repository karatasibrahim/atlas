<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_atlas" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.atlas.muhasebe</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Enterprise'daki "currency_rate_live" yerine TCMB entegrasyonu -->
            <setting id="update_exchange_rates" position="replace">
                <setting id="atlas_tcmb_rates" string="TCMB Kurları" company_dependent="1"
                         help="Döviz kurlarını her iş günü TCMB'den otomatik çek">
                    <field name="atlas_tcmb_auto"/>
                    <div class="content-group mt-2">
                        <div class="row">
                            <label for="atlas_tcmb_rate_type" string="Kur Tipi" class="col-lg-4 o_light_label"/>
                            <field name="atlas_tcmb_rate_type"/>
                        </div>
                        <div class="mt-2">
                            <button name="atlas_action_tcmb_update" type="object" string="Kurları Şimdi Güncelle"
                                    class="btn-link" icon="fa-refresh"/>
                            <button name="%(action_atlas_tcmb_rate_wizard)d" type="action" string="Geçmiş Kurları Çek"
                                    class="btn-link" icon="fa-history"/>
                        </div>
                    </div>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
