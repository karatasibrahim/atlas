<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_atlas_tcmb_rate_wizard_form" model="ir.ui.view">
        <field name="name">atlas.tcmb.rate.wizard.form</field>
        <field name="model">atlas.tcmb.rate.wizard</field>
        <field name="arch" type="xml">
            <form string="TCMB Geçmiş Kur Çekme">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <p class="text-muted">
                    Seçilen aralıktaki her iş gününün TCMB bülteni çekilir. Manuel girilmiş kurlar değiştirilmez.
                </p>
                <footer>
                    <button name="action_fetch" type="object" string="Kurları Çek" class="btn-primary"/>
                    <button string="Vazgeç" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_atlas_tcmb_rate_wizard" model="ir.actions.act_window">
        <field name="name">TCMB Geçmiş Kur Çekme</field>
        <field name="res_model">atlas.tcmb.rate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
