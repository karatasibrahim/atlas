<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_atlas_kalite_kontrol_list" model="ir.ui.view">
        <field name="name">atlas.kalite.kontrol.list</field>
        <field name="model">atlas.kalite.kontrol</field>
        <field name="arch" type="xml">
            <list decoration-danger="durum == 'kaldi'" decoration-success="durum == 'gecti'" decoration-bf="durum == 'bekliyor'" sample="1">
                <header>
                    <button name="action_gecti" type="object" string="Geçti"/>
                </header>
                <field name="name"/>
                <field name="nokta_id"/>
                <field name="asama" optional="show"/>
                <field name="test_tipi" optional="show"/>
                <field name="belge"/>
                <field name="product_id"/>
                <field name="lot_name" optional="show"/>
                <field name="partner_id" optional="hide"/>
                <field name="workcenter_id" optional="hide"/>
                <field name="olcum" optional="hide"/>
                <field name="ekip_id" optional="hide"/>
                <field name="kontrol_eden_id" optional="show"/>
                <field name="kontrol_tarihi" optional="show"/>
                <field name="durum" widget="badge" decoration-success="durum == 'gecti'" decoration-danger="durum == 'kaldi'" decoration-warning="durum == 'bekliyor'"/>
                <button name="action_gecti" type="object" icon="thumb_up" title="Geçti" class="text-success"
                        invisible="durum != 'bekliyor' or test_tipi not in ('talimat', 'gecti_kaldi')"/>
                <button name="action_kaldi" type="object" icon="thumb_down" title="Kaldı" class="text-danger"
                        invisible="durum != 'bekliyor' or test_tipi != 'gecti_kaldi'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_atlas_kalite_kontrol_form" model="ir.ui.view">
        <field name="name">atlas.kalite.kontrol.form</field>
        <field name="model">atlas.kalite.kontrol</field>
        <field name="arch" type="xml">
            <form string="Kalite Kontrolü">
                <header>
                    <button name="action_gecti" type="object" string="Geçti" class="btn-success"
                            invisible="durum != 'bekliyor' or test_tipi not in ('gecti_kaldi', 'foto')"/>
                    <button name="action_gecti" type="object" string="Onayla" class="btn-success"
                            invisible="durum != 'bekliyor' or test_tipi != 'talimat'"/>
                    <button name="action_kaldi" type="object" string="Kaldı" class="btn-danger"
                            invisible="durum != 'bekliyor' or test_tipi not in ('gecti_kaldi', 'foto')"/>
                    <button name="action_degerlendir" type="object" string="Değerlendir" class="btn-primary"
                            invisible="durum != 'bekliyor' or test_tipi not in ('olcum', 'kontrol_listesi', 'sayim')"/>
                    <button name="action_uyari_olustur" type="object" string="Uygunsuzluk Bildir" invisible="durum == 'bekliyor'"/>
                    <button name="action_yazdir" type="object" string="Yazdır"/>
                    <button name="action_sifirla" type="object" string="Sonucu Geri Al" invisible="durum == 'bekliyor'"
                            groups="atlas_kalite.group_kalite_manager" confirm="Kontrol sonucu geri alınacak. Emin misiniz?"/>
                    <field name="durum" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_uyarilar" type="object" class="oe_stat_button" icon="warning" invisible="not uyari_sayisi">
                            <field name="uyari_sayisi" widget="statinfo" string="Uygunsuzluk"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Geçti" bg_color="text-bg-success" invisible="durum != 'gecti'"/>
                    <widget name="web_ribbon" title="Kaldı" bg_color="text-bg-danger" invisible="durum != 'kaldi'"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="nokta_id" readonly="id" options="{'no_create': True}"/>
                            <field name="asama"/>
                            <field name="test_tipi"/>
                            <field name="product_id" readonly="durum != 'bekliyor'"/>
                            <field name="lot_id" readonly="durum != 'bekliyor'" invisible="not product_id" domain="[('product_id', '=', product_id)]"/>
                            <field name="lot_name" readonly="durum != 'bekliyor'" invisible="lot_id or not product_id"/>
                        </group>
                        <group>
                            <field name="picking_id" readonly="id" invisible="production_id"/>
                            <field name="production_id" readonly="id" invisible="picking_id"/>
                            <field name="workorder_id" readonly="id" invisible="not workorder_id"/>
                            <field name="partner_id" invisible="not partner_id"/>
                            <field name="ekip_id"/>
                            <field name="user_id"/>
                            <field name="kontrol_eden_id" invisible="durum == 'bekliyor'"/>
                            <field name="kontrol_tarihi" invisible="durum == 'bekliyor'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Ölçüm" invisible="test_tipi != 'olcum'">
                        <group>
                            <label for="olcum"/>
                            <div class="o_row">
                                <field name="olcum" readonly="durum != 'bekliyor'" decoration-danger="tolerans_disi"/>
                                <field name="olcu_birimi" nolabel="1"/>
                            </div>
                            <field name="olcum_girildi" invisible="1"/>
                            <field name="tolerans_disi" invisible="1"/>
                        </group>
                        <group>
                            <field name="norm"/>
                            <label for="alt_sinir" string="Kabul Aralığı"/>
                            <div class="o_row">
                                <field name="alt_sinir"/> - <field name="ust_sinir"/>
                            </div>
                        </group>
                    </group>
                    <group string="Numune" invisible="test_tipi != 'sayim'">
                        <group>
                            <field name="test_edilen" readonly="durum != 'bekliyor'"/>
                            <field name="hatali" readonly="durum != 'bekliyor'"/>
                        </group>
                        <group>
                            <field name="hata_orani" widget="float" digits="[16, 2]"/>
                            <field name="kabul_orani"/>
                        </group>
                    </group>
                    <field name="madde_ids" invisible="test_tipi != 'kontrol_listesi'" readonly="durum != 'bekliyor'">
                        <list editable="bottom" create="0" delete="0" decoration-danger="sonuc == 'uygun_degil'" decoration-success="sonuc == 'uygun'">
                            <field name="sequence" column_invisible="1"/>
                            <field name="name" readonly="1"/>
                            <field name="sonuc" widget="radio" options="{'horizontal': true}"/>
                            <field name="notlar"/>
                        </list>
                    </field>
                    <notebook>
                        <page string="Sonuç / Notlar" name="sonuc">
                            <group>
                                <field name="foto" widget="image" class="oe_avatar float-none" options="{'size': [240, 240]}"
                                       readonly="durum != 'bekliyor'"/>
                                <field name="notlar" placeholder="Gözlemler..."/>
                            </group>
                        </page>
                        <page string="Talimat" name="talimat">
                            <field name="talimat"/>
                            <group>
                                <field name="dokuman" filename="dokuman_adi" invisible="not dokuman"/>
                                <field name="dokuman_adi" invisible="1"/>
                            </group>
                        </page>
                        <page string="Başarısızlıkta" name="basarisiz" invisible="durum != 'kaldi'">
                            <field name="basarisiz_mesaj"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_atlas_kalite_kontrol_search" model="ir.ui.view">
        <field name="name">atlas.kalite.kontrol.search</field>
        <field name="model">atlas.kalite.kontrol</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="nokta_id"/>
                <field name="product_id"/>
                <field name="lot_name"/>
                <field name="picking_id"/>
                <field name="production_id"/>
                <field name="partner_id"/>
                <filter name="filter_bekliyor" string="Bekleyen" domain="[('durum', '=', 'bekliyor')]"/>
                <filter name="filter_gecti" string="Geçti" domain="[('durum', '=', 'gecti')]"/>
                <filter name="filter_kaldi" string="Kaldı" domain="[('durum', '=', 'kaldi')]"/>
                <separator/>
                <filter name="giris" string="Giriş" domain="[('asama', '=', 'giris')]"/>
                <filter name="ara" string="Üretim Ara" domain="[('asama', '=', 'ara')]"/>
                <filter name="final" string="Final" domain="[('asama', '=', 'final')]"/>
                <filter name="sevkiyat" string="Sevkiyat" domain="[('asama', '=', 'sevkiyat')]"/>
                <separator/>
                <filter name="benim" string="Benim Ekiplerim" domain="['|', ('ekip_id.user_ids', 'in', uid), ('user_id', '=', uid)]"/>
                <filter name="kontrol_tarihi" string="Kontrol Tarihi" date="kontrol_tarihi"/>
                <group>
                    <filter name="group_durum" string="Durum" context="{'group_by': 'durum'}"/>
                    <filter name="group_asama" string="Aşama" context="{'group_by': 'asama'}"/>
                    <filter name="group_nokta" string="Kontrol Noktası" context="{'group_by': 'nokta_id'}"/>
                    <filter name="group_urun" string="Ürün" context="{'group_by': 'product_id'}"/>
                    <filter name="group_partner" string="Cari" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_workcenter" string="İş Merkezi" context="{'group_by': 'workcenter_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_atlas_kalite_kontrol_pivot" model="ir.ui.view">
        <field name="name">atlas.kalite.kontrol.pivot</field>
        <field name="model">atlas.kalite.kontrol</field>
        <field name="arch" type="xml">
            <pivot string="Kalite Analizi" sample="1">
                <field name="nokta_id" type="row"/>
                <field name="durum" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_atlas_kalite_kontrol_graph" model="ir.ui.view">
        <field name="name">atlas.kalite.kontrol.graph</field>
        <field name="model">atlas.kalite.kontrol</field>
        <field name="arch" type="xml">
            <graph string="Kalite Analizi" type="bar" stacked="1" sample="1">
                <field name="kontrol_tarihi" interval="month"/>
                <field name="durum"/>
            </graph>
        </field>
    </record>

    <record id="action_atlas_kalite_kontrol" model="ir.actions.act_window">
        <field name="name">Kalite Kontrolleri</field>
        <field name="res_model">atlas.kalite.kontrol</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="context">{'search_default_filter_bekliyor': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Bekleyen kalite kontrolü yok</p>
            <p>Kontroller, kontrol noktalarına uyan mal kabul, sevkiyat ve üretim belgelerinde otomatik oluşur.</p>
        </field>
    </record>

    <record id="action_atlas_kalite_analiz" model="ir.actions.act_window">
        <field name="name">Kalite Analizi</field>
        <field name="res_model">atlas.kalite.kontrol</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="domain">[('durum', '!=', 'bekliyor')]</field>
    </record>
</odoo>
