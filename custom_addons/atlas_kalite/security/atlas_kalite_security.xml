<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_kalite">
        <field name="name">Kalite</field>
        <field name="sequence">6</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>
    <record id="group_kalite_user" model="res.groups">
        <field name="name">Kalite Kullanıcısı</field>
        <field name="sequence">10</field>
        <field name="comment">Kalite kontrollerini yapar, uygunsuzluk bildirir.</field>
        <field name="privilege_id" ref="res_groups_privilege_kalite"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_kalite_manager" model="res.groups">
        <field name="name">Kalite Yöneticisi</field>
        <field name="sequence">20</field>
        <field name="comment">Kontrol noktalarını tanımlar, uygunsuzlukları kapatır.</field>
        <field name="privilege_id" ref="res_groups_privilege_kalite"/>
        <field name="implied_ids" eval="[(4, ref('group_kalite_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <!-- Depo ve üretim kullanıcıları kendi işlemlerindeki kontrolleri yapabilsin -->
    <record id="stock.group_stock_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_kalite_user'))]"/>
    </record>
</odoo>
