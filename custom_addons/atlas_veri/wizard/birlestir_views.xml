<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_atlas_veri_birlestir_form" model="ir.ui.view">
        <field name="name">atlas.veri.birlestir.form</field>
        <field name="model">atlas.veri.birlestir</field>
        <field name="arch" type="xml">
            <form string="Kayıtları Birleştir">
                <field name="res_model" invisible="1"/>
                <field name="kayit_ids_metin" invisible="1"/>
                <group>
                    <field name="ana_secim" widget="radio"/>
                    <field name="kaldirma" widget="radio"/>
                </group>
                <div class="text-muted small">Diğer kayıtlara bağlı tüm belgeler (faturalar, siparişler, hareketler …) ana kayda taşınır; işlem geri alınamaz.</div>
                <footer>
                    <button name="action_birlestir" type="object" string="Birleştir" class="btn-primary"
                            confirm="Seçili kayıtlar ana kayıtta birleştirilecek. Devam edilsin mi?"/>
                    <button string="Vazgeç" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
