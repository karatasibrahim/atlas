<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_atlas_belge_bagla_form" model="ir.ui.view">
        <field name="name">atlas.belge.bagla.form</field>
        <field name="model">atlas.belge.bagla</field>
        <field name="arch" type="xml">
            <form string="Kayda Bağla">
                <group>
                    <field name="belge_ids" widget="many2many_tags" readonly="1"/>
                    <field name="kayit"/>
                    <field name="dosyayi_ekle"/>
                </group>
                <footer>
                    <button name="action_bagla" type="object" string="Bağla" class="btn-primary"/>
                    <button string="Vazgeç" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_atlas_belge_bagla" model="ir.actions.act_window">
        <field name="name">Kayda Bağla</field>
        <field name="res_model">atlas.belge.bagla</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_atlas_belge"/>
        <field name="binding_view_types">list,form,kanban</field>
    </record>
</odoo>
