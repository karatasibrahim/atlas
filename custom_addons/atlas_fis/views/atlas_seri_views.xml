<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_atlas_seri_list" model="ir.ui.view">
        <field name="name">atlas.seri.list</field>
        <field name="model">atlas.seri</field>
        <field name="arch" type="xml">
            <list string="Seri / Sayaç Tanımları">
                <header>
                    <button name="action_create_default_series" type="object" string="Örnek Serileri Oluştur" display="always"/>
                </header>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="belge_turu_ids" widget="many2many_tags"/>
                <field name="on_ek"/>
                <field name="yil_ekle"/>
                <field name="ayirac" optional="hide"/>
                <field name="hane"/>
                <field name="ornek"/>
                <field name="journal_id" optional="show"/>
                <field name="varsayilan"/>
                <field name="gib_uyumlu" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_atlas_seri_form" model="ir.ui.view">
        <field name="name">atlas.seri.form</field>
        <field name="model">atlas.seri</field>
        <field name="arch" type="xml">
            <form string="Seri / Sayaç">
                <sheet>
                    <widget name="web_ribbon" title="Arşivlendi" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="ör. e-Fatura Satış"/></h1>
                    </div>
                    <group>
                        <group string="Kullanım">
                            <field name="belge_turu_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="journal_id" options="{'no_create': True}"/>
                            <field name="varsayilan"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Numara Biçimi">
                            <field name="on_ek"/>
                            <field name="yil_ekle"/>
                            <field name="ayirac"/>
                            <field name="hane"/>
                            <field name="baslangic_no"/>
                            <field name="ornek" class="fw-bold"/>
                            <field name="gib_uyumlu"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Numara onay anında verilir ve boşluksuz ilerler. Yıl eklenen serilerde sıra no her yıl baştan başlar.
                        e-Fatura / e-Arşiv serileri GİB biçiminde olmalıdır: 3 karakter ön ek + yıl + 9 hane (ör. ATL2026000000001).
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_atlas_seri_search" model="ir.ui.view">
        <field name="name">atlas.seri.search</field>
        <field name="model">atlas.seri</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="on_ek"/>
                <field name="belge_turu_ids"/>
                <filter name="inactive" string="Arşivlenmiş" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_company" string="Şirket" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_atlas_seri" model="ir.actions.act_window">
        <field name="name">Seri / Sayaç Tanımları</field>
        <field name="res_model">atlas.seri</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Seri / sayaç tanımlayın</p>
            <p>Her belge türü (fatura, iade, mahsup, tahsil, tediye...) için ön ek ve sayaç belirleyin.</p>
        </field>
    </record>
</odoo>
